---
import type { SiteFooterBlock } from '~/lib/types/blocks';
import PriceListLinks from '~/components/PriceListLinks.astro';
const { logo, address, phone, email, hours = [], socialLinks = [], supportLogos = [] } = Astro.props as SiteFooterBlock;
const currentYear = new Date().getFullYear();
const [emailLocal = '', emailDomain = ''] = email.split('@');
---
<div class="footer-container" id="footer" data-module="footerEmail fade" data-module-y="24" data-module-stagger="0.12">
  <div class="left" data-fade>
    <h1>Contacts</h1>
    <div class="contacts-info">
      <div class="footer-center location"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="currentColor" d="M12 20.8995 16.9497 15.9497C19.6834 13.2161 19.6834 8.78392 16.9497 6.05025 14.2161 3.31658 9.78392 3.31658 7.05025 6.05025 4.31658 8.78392 4.31658 13.2161 7.05025 15.9497L12 20.8995ZM12 23.7279 5.63604 17.364C2.12132 13.8492 2.12132 8.15076 5.63604 4.63604 9.15076 1.12132 14.8492 1.12132 18.364 4.63604 21.8787 8.15076 21.8787 13.8492 18.364 17.364L12 23.7279ZM12 13C13.1046 13 14 12.1046 14 11 14 9.89543 13.1046 9 12 9 10.8954 9 10 9.89543 10 11 10 12.1046 10.8954 13 12 13ZM12 15C9.79086 15 8 13.2091 8 11 8 8.79086 9.79086 7 12 7 14.2091 7 16 8.79086 16 11 16 13.2091 14.2091 15 12 15Z"/></svg>{address}</div>
      <div class="footer-center phone"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 0 1 2-2h3.28a1 1 0 0 1 .948.684l1.498 4.493a1 1 0 0 1-.502 1.21l-2.257 1.13a11.042 11.042 0 0 0 5.516 5.516l1.13-2.257a1 1 0 0 1 1.21-.502l4.493 1.498a1 1 0 0 1 .684.949V19a2 2 0 0 1-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>{phone}</div>
      <div class="footer-center email"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="none" d="M0 0h24v24H0z"/><path fill="currentColor" d="M12 1.95c-5.52 0-10 4.48-10 10s4.48 10 10 10h5v-2h-5c-4.34 0-8-3.66-8-8s3.66-8 8-8 8 3.66 8 8v1.43c0 .79-.71 1.57-1.5 1.57s-1.5-.78-1.5-1.57v-1.43c0-2.76-2.24-5-5-5s-5 2.24-5 5 2.24 5 5 5c1.38 0 2.64-.56 3.54-1.47.65.89 1.77 1.47 2.96 1.47 1.97 0 3.5-1.6 3.5-3.57v-1.43c0-5.52-4.48-10-10-10m0 13c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3"/></svg><span data-email-local={emailLocal} data-email-domain={emailDomain}></span></div>
    </div>
  </div>
  <div class="center" data-fade>
    {logo?.src ? <img src={logo.src} alt={logo.alt || ''} /> : null}
    <div class="logos">
      {socialLinks.map((link) => (
        <a
          href={link.label === 'Email' ? '#footer' : link.href}
          aria-label={link.label}
          data-email-local={link.label === 'Email' ? emailLocal : undefined}
          data-email-domain={link.label === 'Email' ? emailDomain : undefined}
        >
          {link.label === 'Facebook' && (
            <svg viewBox="0 0 24 24" width="42" height="42" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M9.94474914 22V13.1657526H7V9.48481614h2.94474914V6.54006699C9.94474914 3.49740494 11.8713513 2 14.5856738 2c1.3001067 0 2.417639.09717672 2.7430338.13987558v3.18032908h-1.8824309c-1.4760555.00073619-1.8205911.70232267-1.8205911 1.7315125v2.43309898h3.6809364l-.7361873 3.68093646h-2.9447491L13.6845806 22"/></svg>
          )}
          {link.label === 'Instagram' && (
            <svg viewBox="0 0 448 512" width="42" height="42" aria-hidden="true"><path fill="currentColor" d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"/></svg>
          )}
          {link.label === 'Tripadvisor' && (
            <svg viewBox="0 0 576 512" width="42" height="42" aria-hidden="true"><path fill="currentColor" d="M528.91 178.82 576 127.58H471.66a326.11 326.11 0 0 0-367 0H0l47.09 51.24A143.911 143.911 0 0 0 241.86 390.73L288 440.93l46.11-50.17A143.94 143.94 0 0 0 575.88 285.18h-.03A143.56 143.56 0 0 0 528.91 178.82ZM144.06 382.57a97.39 97.39 0 1 1 97.39-97.39A97.39 97.39 0 0 1 144.06 382.57ZM288 282.37c0-64.09-46.62-119.08-108.09-142.59a281 281 0 0 1 216.17 0C334.61 163.3 288 218.29 288 282.37Zm143.88 100.2h-.01a97.405 97.405 0 1 1 .01 0ZM144.06 234.12h-.01a51.06 51.06 0 1 0 51.06 51.06v-.11A51 51 0 0 0 144.06 234.12Zm287.82 0a51.06 51.06 0 1 0 51.06 51.06A51.06 51.06 0 0 0 431.88 234.12Z"/></svg>
          )}
          {link.label === 'Email' && (
            <svg viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7"/><path d="m3 7 9 6 9-6"/></svg>
          )}
        </a>
      ))}
    </div>
    <div class="images">
      {supportLogos.map((supportLogo) => (
        <img src={supportLogo.src} alt={supportLogo.alt || ''} />
      ))}
    </div>
  </div>
  <div class="right" data-fade>
    <h1>Working Hours</h1>
    <div class="hours">
      {hours.map((row) => <li><span class="day">{row.label}</span> {row.value}</li>)}
    </div>
  </div>
</div>
<PriceListLinks />
<div class="copyright-bar">Copyright @ {currentYear} River</div>

<style>
  .logos a {
    color: white;
    text-decoration: none;
  }
</style>
