---
import type { WineListBlock } from '~/lib/types/blocks';
import { showMenuLink } from '~/lib/menu-availability';
import croFlag from '~/assets/images/hr.png';
import engFlag from '~/assets/images/eng.jpg';

type WineLanguage = 'hr' | 'en';
type WineListProps = WineListBlock & {
  initialLanguage?: WineLanguage;
};

const { title, languages, initialLanguage = 'hr' } = Astro.props as WineListProps;
const euro = (price?: string) => String(price ?? '').replace('.', ',');
const anchorLine = (price?: string, date?: string) => {
  if (!price) return '';
  return `${euro(price)} €${date ? ` (${date})` : ''}`;
};
const selectedLanguage = initialLanguage === 'en' ? 'en' : 'hr';
const selected = languages.find((language) => language.code === selectedLanguage) ?? languages.find((language) => language.code === 'hr') ?? languages[0];
const menuNav = [
  { hr: 'Hrana', en: 'Food', hrefHr: '/hrana', hrefEn: '/menu' },
  { hr: 'Piće', en: 'Drinks', hrefHr: '/pice', hrefEn: '/drinks' },
  { hr: 'Pizza', en: 'Pizza', hrefHr: '/pizza', hrefEn: '/pizza-en' },
  { hr: 'Vino', en: 'Wine', hrefHr: '/vino', hrefEn: '/wine' }
].filter((item) => showMenuLink(item.hrefEn));
---

<div class="language-modal-container astro-hidden" data-language-modal>
  <div class="language-modal-content">
    <button class="astro-language-close" type="button" aria-label="Close language picker">
      <svg viewBox="0 0 512 512" width="46" height="46" aria-hidden="true">
        <path fill="currentColor" d="M278.6 256l68.2-68.2c6.2-6.2 6.2-16.4 0-22.6-6.2-6.2-16.4-6.2-22.6 0L256 233.4l-68.2-68.2c-6.2-6.2-16.4-6.2-22.6 0-3.1 3.1-4.7 7.2-4.7 11.3 0 4.1 1.6 8.2 4.7 11.3l68.2 68.2-68.2 68.2c-3.1 3.1-4.7 7.2-4.7 11.3 0 4.1 1.6 8.2 4.7 11.3 6.2 6.2 16.4 6.2 22.6 0l68.2-68.2 68.2 68.2c6.2 6.2 16.4 6.2 22.6 0 6.2-6.2 6.2-16.4 0-22.6L278.6 256z" />
      </svg>
    </button>
    <h1>Change language:</h1>
    <div class="language">
      <a class="hrv astro-language-option" href="/vino">
        <img src={croFlag.src} alt="" />
        <p>HR</p>
        <span class:list={['checkmark', selectedLanguage !== 'hr' && 'astro-hidden']}>
          <svg viewBox="0 0 48 48" width="26" height="26" aria-hidden="true">
            <polygon fill="#43A047" points="40.6,12.1 17,35.7 7.4,26.1 4.6,29 17,41.3 43.4,14.9" />
          </svg>
        </span>
      </a>
      <a class="eng astro-language-option" href="/wine">
        <img src={engFlag.src} alt="" />
        <p>EN</p>
        <span class:list={['checkmark', selectedLanguage !== 'en' && 'astro-hidden']}>
          <svg viewBox="0 0 48 48" width="26" height="26" aria-hidden="true">
            <polygon fill="#43A047" points="40.6,12.1 17,35.7 7.4,26.1 4.6,29 17,41.3 43.4,14.9" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</div>

<div class="menu-container" data-module="winePage fade" data-module-y="24" data-module-stagger="0.08">
  <div class="menu-top-bar" data-fade>
  <div class="top-bar">
    <a href="/" aria-label="Back" class="menu-back-link">
      <svg viewBox="0 0 512 512" width="46" height="46" aria-hidden="true">
        <path
          fill="none"
          stroke="currentColor"
          stroke-miterlimit="10"
          stroke-width="32"
          d="M256 64C150 64 64 150 64 256s86 192 192 192 192-86 192-192S362 64 256 64z"
        />
        <path
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="32"
          d="M296 352l-96-96 96-96"
        />
      </svg>
    </a>
    <button class:list={[selectedLanguage === 'hr' ? 'hrv' : 'eng', 'astro-language-toggle']} type="button" aria-label="Change language">
      <img src={selectedLanguage === 'hr' ? croFlag.src : engFlag.src} alt="" />
    </button>
  </div>

  <div class="center-nav">
    <div class="center-nav-container">
      {menuNav.map((item) => <a href={selectedLanguage === 'hr' ? item.hrefHr : item.hrefEn}>{selectedLanguage === 'hr' ? item.hr : item.en}</a>)}
    </div>
  </div>
  </div>
  <div class="vine-container-content" data-fade>
    <h2>{title}</h2>
    <div class="vine-categories-container">
      <div class="vine-categories">
        {selected.categories.map((category) => (
          <>
            <h3>{category.title}</h3>
            {category.items.map((item) => (
              <div class="vine-category">
                <div class="vine-content">
                  <h4>{item.name}</h4>
                  {item.quantity ? <p>{item.quantity}</p> : null}
                  {item.description ? <p>{item.description}</p> : null}
                </div>
                <div class="vine-price">
                  <div>
                    <strong>{euro(item.priceEur)}€</strong>
                    {item.anchorPriceEur ? <small>Sidrena cijena:<br />{anchorLine(item.anchorPriceEur, item.anchorPriceDate)}</small> : null}
                  </div>
                </div>
              </div>
            ))}
          </>
        ))}
      </div>
    </div>
  </div>
</div>
