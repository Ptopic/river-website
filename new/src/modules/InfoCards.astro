---
import type { InfoCardsBlock } from '~/lib/types/blocks';

const { cards = [] } = Astro.props as InfoCardsBlock;
const left = cards[0];
const right = cards[1];
---
<div class="info-container" id="info-container">
  {left ? (
    <div class="info-left" data-module="fade" data-module-y="0">
      <div class="blured-content">
        <h1 data-fade data-fade-x="-50" data-fade-delay="0.2">{left.title}</h1>
        <p data-fade data-fade-x="-50" data-fade-delay="0.35">{left.text}</p>
        {left.href ? <a href={left.href} data-fade data-fade-x="-50" data-fade-delay="0.5">{left.label}</a> : null}
      </div>
    </div>
  ) : null}
  {right ? (
    <div class="info-right" data-module="fade" data-module-y="0">
      <div class="blured-content">
        <h1 data-fade data-fade-x="50" data-fade-delay="0.2">{right.title}</h1>
        <p data-fade data-fade-x="50" data-fade-delay="0.35">{right.text}</p>
        {right.href ? <a href={right.href} class="btn info" data-fade data-fade-x="50" data-fade-delay="0.5">{right.label}</a> : null}
      </div>
    </div>
  ) : null}
</div>
