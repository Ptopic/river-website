---
import type { SiteNavBlock } from '~/lib/types/blocks';
import { showMenuLink } from '~/lib/menu-availability';

const { logo, items, cta } = Astro.props as SiteNavBlock;
const visibleItems = items.filter((item) => showMenuLink(item.href));
const visibleCta = cta && showMenuLink(cta.href) ? cta : undefined;
const isPriceListHref = (href: string) => /^\/cjenik\/?(?:[?#]|$)/.test(href.trim());
const hasPriceListLink = visibleItems.some((item) => isPriceListHref(item.href))
  || Boolean(visibleCta && isPriceListHref(visibleCta.href));
---
<nav class="navbar" data-module="siteNav">
  <div class="left-navbar">
    {logo?.src ? <img src={logo.src} alt={logo.alt || ''} /> : null}
  </div>

  <div class="center-navbar">
    {visibleItems.map((item) => <div class="nav-link"><a href={item.href} data-no-transition={isPriceListHref(item.href) || undefined}>{item.label}</a></div>)}
    {!hasPriceListLink && <div class="nav-link"><a href="/cjenik" data-no-transition>Digitalni cjenik</a></div>}
    {visibleCta ? <a href={visibleCta.href} class="btn" data-no-transition={isPriceListHref(visibleCta.href) || undefined}>{visibleCta.label}</a> : null}
  </div>
</nav>

<div class="navbar-mobile">
  <button class="navbar-button astro-mobile-menu-toggle" type="button" aria-label="Toggle menu" aria-expanded="false">
    <span class="navbar-button__bar"></span>
    <span class="navbar-button__bar"></span>
    <span class="navbar-button__bar"></span>
  </button>
</div>

<div class="navbar-mobile-container" style="transform: translateX(100%)">
  <div class="navbar-mobile-content">
    {visibleItems.map((item) => (
      <div class="nav-link"><a href={item.href} data-no-transition={isPriceListHref(item.href) || undefined}>{item.label.toUpperCase()}</a></div>
    ))}
    {!hasPriceListLink && <div class="nav-link"><a href="/cjenik" data-no-transition>DIGITALNI CJENIK</a></div>}
    {visibleCta ? <a href={visibleCta.href} class="btn" data-no-transition={isPriceListHref(visibleCta.href) || undefined}>{visibleCta.label}</a> : null}
  </div>
</div>
