---
import type { GalleryBlock } from '~/lib/types/blocks';

const { images = [] } = Astro.props as GalleryBlock;
---
<div class="image-modal-overlay astro-hidden" data-gallery-modal>
  <div class="button-container-overlay">
    <button class="astro-modal-close" type="button" aria-label="Close image">
      <svg viewBox="0 0 512 512" width="42" height="42" aria-hidden="true">
        <path fill="currentColor" d="M405 136.8 375.2 107 256 226.2 136.8 107 107 136.8 226.2 256 107 375.2 136.8 405 256 285.8 375.2 405 405 375.2 285.8 256 405 136.8z"/>
      </svg>
    </button>
  </div>
  <div class="image-modal">
    {images[0] ? <img src={images[0].src} alt={images[0].alt || ''} data-gallery-modal-image /> : null}
  </div>
</div>

<div class="pictures-container" id="galery" data-module="gallery fade" data-module-y="0">
  {images.map((image, index) => (
    <button class={`img${index + 1} img astro-gallery-button`} type="button" data-gallery-index={index} data-fade data-fade-x={index === 2 || index === 5 ? '50' : '-50'} data-fade-delay={String(0.2 + index * 0.4)}>
      <img src={image.src} alt={image.alt || `img${index + 1}`} />
      <div class="overlay">
        <div class="border">
          <svg viewBox="0 0 24 24" width="80" height="80" aria-hidden="true">
            <path fill="currentColor" d="m21.53 20.47-4.82-4.82a8.25 8.25 0 1 0-1.06 1.06l4.82 4.82a.75.75 0 1 0 1.06-1.06ZM10.25 17a6.75 6.75 0 1 1 0-13.5 6.75 6.75 0 0 1 0 13.5Z"/>
          </svg>
        </div>
      </div>
    </button>
  ))}
</div>

<style>
  .pictures-container button.img {
    appearance: none;
    border: 0;
    padding: 0;
    background: transparent;
    color: white;
  }

  .pictures-container .border {
    color: var(--primary);
    line-height: 1;
  }
</style>
