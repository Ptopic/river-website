---
import { priceListConfigured } from '~/lib/content/wordpress';
---
<nav class="price-list-links" aria-label="Digitalni cjenik">
  {priceListConfigured && <a href="/cjenik/preuzmi" download data-no-transition>Preuzmi CSV cjenik</a>}
  <a href="/cjenik" data-no-transition>Arhiva cjenika</a>
</nav>

<style>
  .price-list-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    padding: 1.25rem;
    background: var(--background500);
    color: #fff;
    font-family: 'oscine', sans-serif;
    font-size: 1.5rem;
    letter-spacing: 0;
  }
  .price-list-links a { color: var(--primary); text-underline-offset: 0.2em; }
</style>
